<!DOCTYPE html>
<html lang="en" data-dir="{{DIR}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{TITLE}}</title>
<style>
  :root {
    color-scheme: light dark;
    --surface-0: #f4f4f2;
    --surface-1: #fcfcfb;
    --surface-2: #f0efec;
    --border:    #e2e1dc;
    --text-primary:   #0b0b0b;
    --text-secondary: #52514e;
    --text-muted:     #86857f;
    --series-1: #2a78d6;
    --series-1-soft: #cde2fb;
    --good: #0ca30c;
    --warning: #eda100;
    --accent: #4a3aa7;
    --shadow: 0 1px 2px rgba(11,11,11,.06), 0 4px 16px rgba(11,11,11,.05);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --surface-0: #141413;
      --surface-1: #1a1a19;
      --surface-2: #232321;
      --border:    #333330;
      --text-primary:   #ffffff;
      --text-secondary: #c3c2b7;
      --text-muted:     #8f8e85;
      --series-1: #3987e5;
      --series-1-soft: #1c3d63;
      --good: #0ca30c;
      --warning: #c98500;
      --accent: #9085e9;
      --shadow: 0 1px 2px rgba(0,0,0,.4), 0 4px 16px rgba(0,0,0,.35);
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--surface-0);
    color: var(--text-primary);
    font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans Hebrew", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: 1040px; margin: 0 auto; padding: 32px 24px 64px; }
  header.page { margin-bottom: 28px; }
  header.page h1 { font-size: 26px; margin: 0 0 6px; letter-spacing: -.01em; }
  header.page .scope { color: var(--text-secondary); font-size: 14px; }
  header.page .scope code { background: var(--surface-2); padding: 1px 6px; border-radius: 5px; font-size: 12.5px; }
  h2.section { font-size: 13px; text-transform: uppercase; letter-spacing: .07em; color: var(--text-muted); margin: 36px 0 14px; font-weight: 600; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 14px; }
  .tile {
    background: var(--surface-1); border: 1px solid var(--border); border-radius: 12px;
    padding: 18px 18px 16px; box-shadow: var(--shadow);
  }
  .tile .label { font-size: 12.5px; color: var(--text-secondary); margin-bottom: 8px; }
  .tile .value { font-size: 30px; font-weight: 650; letter-spacing: -.02em; line-height: 1; }
  .tile .value small { font-size: 15px; font-weight: 500; color: var(--text-muted); margin-left: 3px; }
  .tile .sub { font-size: 12px; color: var(--text-muted); margin-top: 8px; }
  .card {
    background: var(--surface-1); border: 1px solid var(--border); border-radius: 12px;
    padding: 20px; box-shadow: var(--shadow); margin-top: 14px;
  }
  .card h3 { margin: 0 0 4px; font-size: 16px; }
  .card .hint { color: var(--text-muted); font-size: 12.5px; margin: 0 0 16px; }
  table { border-collapse: collapse; width: 100%; font-size: 13.5px; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); }
  th { color: var(--text-secondary); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .bar-row { display: grid; grid-template-columns: 180px 1fr 84px; align-items: center; gap: 12px; margin: 7px 0; }
  .bar-row .name { font-size: 13px; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bar-track { background: var(--surface-2); border-radius: 6px; height: 22px; overflow: hidden; }
  .bar-fill { background: var(--series-1); height: 100%; border-radius: 6px; min-width: 2px; }
  .bar-row .val { text-align: right; font-variant-numeric: tabular-nums; font-size: 13px; color: var(--text-secondary); }
  .vbars { display: flex; align-items: flex-end; gap: 14px; height: 200px; padding-top: 10px; }
  .vbar { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; gap: 6px; }
  .vbar .col { width: 100%; max-width: 70px; background: var(--series-1); border-radius: 6px 6px 0 0; min-height: 2px; }
  .vbar .n { font-size: 12.5px; color: var(--text-secondary); font-variant-numeric: tabular-nums; }
  .vbar .x { font-size: 12px; color: var(--text-muted); }
  .notes { font-size: 13px; color: var(--text-secondary); background: var(--surface-1); border: 1px solid var(--border); border-left: 3px solid var(--warning); border-radius: 10px; padding: 14px 16px; margin-top: 14px; }
  .notes ul { margin: 6px 0 0; padding-left: 20px; }
  footer { margin-top: 40px; color: var(--text-muted); font-size: 12px; border-top: 1px solid var(--border); padding-top: 16px; }
  [data-dir="rtl"] body { direction: rtl; }
  [data-dir="rtl"] th, [data-dir="rtl"] td { text-align: right; }
  [data-dir="rtl"] td.num, [data-dir="rtl"] th.num { text-align: left; }
  [data-dir="rtl"] .bar-row { grid-template-columns: 180px 1fr 84px; }
  [data-dir="rtl"] .notes { border-left: none; border-right: 3px solid var(--warning); }
</style>
</head>
<body>
  <div class="wrap">
    <header class="page">
      <h1>{{TITLE}}</h1>
      <div class="scope">{{SCOPE_LINE}}</div>
    </header>

    <h2 class="section">{{L_HEADLINE}}</h2>
    <div class="tiles">{{STAT_TILES}}</div>

    <h2 class="section">{{L_VOLUME}}</h2>
    <div class="card">
      <h3>{{L_VOLUME_TITLE}}</h3>
      <p class="hint">{{L_VOLUME_HINT}}</p>
      {{VOLUME_CHART}}
    </div>

    <h2 class="section">{{L_TOPICS}}</h2>
    <div class="card">
      <h3>{{L_TOPICS_TITLE}}</h3>
      <p class="hint">{{L_TOPICS_HINT}}</p>
      {{TOPIC_CHART}}
    </div>

    <h2 class="section">{{L_PINGPONG}}</h2>
    <div class="card">
      <h3>{{L_PINGPONG_TITLE}}</h3>
      <p class="hint">{{L_PINGPONG_HINT}}</p>
      {{PINGPONG_CHART}}
    </div>

    <h2 class="section">{{L_RESOLUTION}}</h2>
    <div class="card">{{RESOLUTION_BLOCK}}</div>

    {{NOTES}}

    <footer>{{FOOTER}}</footer>
  </div>
</body>
</html>
